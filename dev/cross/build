#!/usr/bin/env bash
# shellcheck disable=SC2155
set -euo pipefail
trap "exit" INT
# shellcheck source=./../lib/utils.sh
source "${BASH_SOURCE%/*}/../lib/utils.sh"

function build() {
  trap "exit" INT

  local name="${1:?}"
  declare -x TASK="${name}"
  declare -x CROSS_COMPILE="${2:-${CROSS_COMPILE:?}}"
  declare -x BUILD_TIME="${BUILD_TIME:-"$(datetime_safe)"}"
  declare -x BUILD_DIR="${BUILD_DIR:-"$(project_root)/.build/${CROSS_COMPILE}"}"
  declare -x INSTALL_DIR="${INSTALL_DIR:-"$(project_root)/.install/${CROSS_COMPILE}/${BUILD_TIME}/${name}"}"
  declare -x OUT_DIR="${OUT_DIR:-"$(project_root)/.out/${BUILD_TIME}"}"

  # The binary tools of the target that its image names (CC_<target> and so on).
  local tool value
  for tool in CC CXX ADDR2LINE AR AS CPP ELFEDIT LD LDD NM OBJCOPY OBJDUMP RANLIB READELF SIZE STRINGS STRIP; do
    if value="$(getenv_cross "${tool}" "${CROSS_COMPILE}")"; then
      declare -x "${tool}=${value}"
    fi
  done
  : "${CC:?"The image names no C compiler for ${CROSS_COMPILE} (CC_${CROSS_COMPILE})"}"

  declare -x CCACHE_DIR="$(get_cache_dir "${CROSS_COMPILE}")/ccache"
  declare -x CCACHE_NOCOMPRESS="1"
  declare -x CCACHE_MAXSIZE="50G"
  declare -x CMAKE_C_COMPILER_LAUNCHER="ccache"
  declare -x CMAKE_CXX_COMPILER_LAUNCHER="ccache"

  # The CPU baseline of the consumers' builds, which link these archives: a
  # library above it stops the consumer with an illegal instruction on an older
  # CPU that the consumer itself supports. These are the flags of
  # export_dist_flags in dev/lib/dist-flags.sh of TreeTime.
  # - x86_64: x86-64-v2 (SSE4.2, POPCNT, CMPXCHG16B)
  # - aarch64 Linux: Armv8.0, with atomics through the outline atomics helpers,
  #   which use LSE instructions when the CPU has them
  # - aarch64 Windows: LSE atomics of Armv8.1, which Windows 11 on Arm requires;
  #   the Windows targets have no outline atomics helpers
  # - aarch64 macOS: Apple M1, the first Apple CPU with an arm64 Mac
  local cpu_flags=""
  case "${CROSS_COMPILE}" in
  aarch64-apple* | aarch64-darwin*)
    cpu_flags="-mcpu=apple-m1"
    ;;
  aarch64-*-windows-*)
    cpu_flags="-march=armv8-a+lse"
    ;;
  aarch64*)
    cpu_flags="-march=armv8-a -moutline-atomics"
    ;;
  x86_64*)
    cpu_flags="-march=x86-64-v2"
    ;;
  esac

  # The msvcrt target serves the Windows 7 build of the consumers, so the
  # Windows headers declare only the functions of Windows 7.
  local win32_winnt=""
  if [[ "${CROSS_COMPILE}" == "x86_64-pc-windows-gnu" ]]; then
    win32_winnt="0x0601"
  fi

  local opt_flags="-fPIC -g0 -O3 -ftree-vectorize -funroll-loops"
  local sysroot="${CROSS_SYSROOT:+--sysroot=${CROSS_SYSROOT}}"

  local ldflags="-s"

  # emcc brings its own sysroot and links one static WebAssembly module: no
  # position-independent code, and `-s` would start an emcc setting instead of
  # stripping. ccache does not recognize emcc as a compiler.
  if [[ "${CROSS_COMPILE}" == wasm32-* ]]; then
    opt_flags="-g0 -O3"
    sysroot=""
    ldflags=""
    unset CMAKE_C_COMPILER_LAUNCHER CMAKE_CXX_COMPILER_LAUNCHER
  fi

  local common_flags
  common_flags="$(join_words "-w ${opt_flags} ${cpu_flags} ${win32_winnt:+-D_WIN32_WINNT=${win32_winnt}} ${sysroot}")"

  declare -x CFLAGS
  CFLAGS="$(join_words "${CFLAGS:-} ${common_flags}")"
  declare -x CXXFLAGS
  CXXFLAGS="$(join_words "${CXXFLAGS:-} ${common_flags}")"
  declare -x LDFLAGS
  LDFLAGS="$(join_words "${LDFLAGS:-} ${common_flags} ${ldflags}")"

  # The task adds the C flags to the record when it packages the library,
  # because it can add flags of its own.
  declare -x BUILD_RECORD
  BUILD_RECORD="$(toolchain_record "${cpu_flags}" "${win32_winnt}")"

  nicely "$(project_root)/tasks/${name}/build"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  build "$@"
fi
