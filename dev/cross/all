#!/usr/bin/env bash
# shellcheck disable=SC2155
set -euo pipefail
trap "exit" INT
# shellcheck source=./../lib/utils.sh
source "${BASH_SOURCE%/*}/../lib/utils.sh"

# The targets of a plain run. wasm32-unknown-emscripten builds only on request
# (--target=wasm32-unknown-emscripten), each task in every variant of
# WASM_VARIANTS, and by default the tasks of WASM_TASKS.
targets=("${NATIVE_TARGETS[@]}")

export BUILD_TIME="${BUILD_TIME:-$(datetime_safe)}"
# Resolved here, because the functions that GNU parallel runs have no source
# file to resolve it from.
export PROJECT_ROOT="$(project_root)"

function build_one_name() {
  set -euxo pipefail
  trap "exit" INT
  # GNU parallel passes exported functions but no arrays, so the task and target
  # lists come from the library again.
  # shellcheck source=./../lib/utils.sh
  source "${PROJECT_ROOT:?}/dev/lib/utils.sh"

  local name="${1:?}"
  declare -x CROSS_COMPILE="${CROSS_COMPILE:?}"
  declare -x BUILD_TIME="${BUILD_TIME:?}"

  if [[ "${CROSS_COMPILE}" != "${WASM_TARGET}" ]] &&
    ! task_targets "${PROJECT_ROOT:?}" "${name}" | grep -qxF "${CROSS_COMPILE}"; then
    info "Skipping '${name}' for '${CROSS_COMPILE}', which tasks/${name}/targets does not list"
    return
  fi

  local variants=("plain") variant
  if [[ "${CROSS_COMPILE}" == "${WASM_TARGET}" ]]; then
    variants=("${WASM_VARIANTS[@]}")
  fi
  for variant in "${variants[@]}"; do
    info "Building '${name}' (${variant}) for '${CROSS_COMPILE}'"
    VARIANT="${variant}" ./dev/docker/run ./dev/cross/build "${name}" || {
      err "Build failed: '${name}' (${variant}) for ${CROSS_COMPILE}"
      return 1
    }
  done
}
export -f build_one_name

function run_one() {
  set -euxo pipefail
  trap "exit" INT
  # shellcheck source=./../lib/utils.sh
  source "${PROJECT_ROOT:?}/dev/lib/utils.sh"

  declare -x CROSS_COMPILE="${1:?}"
  local name="${2:-}"
  declare -x BUILD_TIME="${BUILD_TIME:?}"

  if [ -n "${name}" ] && [ "${name}" != "all" ]; then
    build_one_name "${name}"
  else
    local names=() task_name
    if [[ "${CROSS_COMPILE}" == "${WASM_TARGET}" ]]; then
      names=("${WASM_TASKS[@]}")
    else
      mapfile -t names < <(task_names "${PROJECT_ROOT:?}")
    fi
    if ((${#names[@]} == 0)); then
      err "No tasks found in ${PROJECT_ROOT}/tasks"
      return 1
    fi
    for task_name in "${names[@]}"; do
      build_one_name "${task_name}"
    done
  fi
}
export -f run_one

function run_serial() {
  set -euxo pipefail
  trap "exit" INT

  local target name
  for target in "${targets[@]}"; do
    for name in "${@:-all}"; do
      run_one "${target}" "${name}"
    done
  done
}
export -f run_serial

function run_parallel() {
  set -euxo pipefail
  trap "exit" INT

  # shellcheck disable=SC2016
  parallel \
    --line-buffer \
    --tag --tagstring '|{#}| \033[34m{= sprintf("%-s", $_) =}\033[0m' \
    --jobs="${#targets[@]}" \
    run_one \
    ::: "${targets[@]}" ::: "${@:-all}"
}
export -f run_parallel

function run_in_tmux_split() {
  set -euo pipefail
  trap "exit" INT

  local session=$(datetime_ms_safe)

  # Run builds in parallel, in a separate tmux windows.
  # Kill tmux server with `Ctrl`+`b` followed by `k` (change `b` to your "prefix" shortcut if it's not default)
  tmux new-session -d -s "${session}"
  tmux send-keys -t "${session}" 'exit' C-m # Close the initial shell to start with a clean layout

  # begin: eye candy options
  tmux set -g mouse on
  tmux set -g default-terminal "screen-256color"
  tmux unbind k
  tmux bind k kill-session
  tmux set -g pane-border-status top
  tmux set -g pane-border-format "#{pane_title}"
  tmux set -g pane-border-style "bg=colour235,fg=colour8"
  tmux set -g pane-active-border-style "bg=colour242,fg=colour237"
  # end: eye candy options

  local target
  for target in "${targets[@]}"; do
    tmux split-window -v -t "${session}" bash -c "source ${BASH_SOURCE[0]}; run_one ${target} ${*:-all} || true; exec $SHELL"
    tmux select-layout -t "${session}" even-vertical
    tmux select-pane -t "" -T "${target}"
  done

  tmux kill-pane -t 0 # Remove the initial empty pane
  tmux attach -t "${session}"
}

function main() {
  local arg args selected=()
  for arg in "$@"; do
    case ${arg} in
    --target=*)
      selected+=("${arg#--target=}")
      ;;
    --split)
      local split=1
      ;;
    --serial)
      local serial=1
      ;;
    --parallel)
      # This is the default
      ;;
    *)
      args+=("${arg}")
      ;;
    esac
  done

  if ((${#selected[@]} > 0)); then
    targets=("${selected[@]}")
  fi

  if [ -n "${split:-}" ]; then
    run_in_tmux_split "${args[@]}"
  elif [ -n "${serial:-}" ]; then
    run_serial "${args[@]}"
  else
    run_parallel "${args[@]}"
  fi
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
