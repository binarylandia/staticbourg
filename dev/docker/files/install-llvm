#!/usr/bin/env bash
#
# Usage: $0 <prefix> [--mingw]
#
# Install LLVM 23 of binarylandia/build_llvm into a prefix: clang, lld, and the
# LLVM binary tools. With --mingw, also install the llvm-mingw archive of the
# same release over it: the static UCRT MinGW sysroots of x86_64-w64-mingw32 and
# aarch64-w64-mingw32, compiler-rt for Windows, and the <triple>-clang drivers,
# which load the sysroot, compiler-rt, libunwind, and lld from the
# <triple>.cfg files next to them.
#
# The prefix gets the download records llvm.json and, with --mingw,
# llvm-mingw.json (see /fetch).
#
set -euxo pipefail

dest="${1:?prefix}"
mingw="${2:-}"
version="23.1.4"
build_time="2026-10-27_17-07-15"
release="llvm-${version}-${build_time}"
mkdir -p "${dest}"

install_archive() {
  local name="${1}" record="${2}" archive="/tmp/${1}"
  /fetch "https://github.com/binarylandia/build_llvm/releases/download/${release}/${name}" "${archive}" "${record}"
  zstd -dc -T0 "${archive}" | tar -C "${dest}" -x
  rm "${archive}"
}

install_archive "${release}.tar.zst" "${dest}/llvm.json"
"${dest}/bin/clang" --version

if [[ "${mingw}" == "--mingw" ]]; then
  install_archive "llvm-mingw-${version}-${build_time}.tar.zst" "${dest}/llvm-mingw.json"
  for triple in x86_64-w64-mingw32 aarch64-w64-mingw32; do
    "${dest}/bin/${triple}-clang" --version
  done
fi
