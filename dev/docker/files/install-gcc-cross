#!/usr/bin/env bash
#
# Usage: $0 <triplet> <prefix>
#
# Install a GCC 16 toolchain of binarylandia/build_crosstool-ng for a target
# triplet into a prefix. The Linux builds compile and link with clang, which
# takes the sysroot (glibc 2.17 or musl 1.2.6), the crt files, libgcc, and
# libstdc++ of the toolchain (install-clang-target); the MinGW toolchain
# (x86_64-w64-mingw32, msvcrt) compiles and links with its own GCC.
#
# The prefix gets the download record toolchain.json (see /fetch).
#
set -euxo pipefail

triplet="${1:?triplet}"
dest="${2:?prefix}"
version="16.2.0"
build_time="2026-10-18_08-33-54"
release="gcc-15.3.0_${version}-${build_time}"
archive="/tmp/gcc-cross.tar.xz"
mkdir -p "${dest}"

/fetch "https://github.com/binarylandia/build_crosstool-ng/releases/download/${release}/gcc-${version}-${triplet}-${build_time}.tar.xz" "${archive}" "${dest}/toolchain.json"
pixz -dp "$(nproc)" <"${archive}" | tar -C "${dest}" -x
rm "${archive}"

test -d "${dest}/lib/gcc/${triplet}/${version}"
test -d "${dest}/${triplet}/sysroot"
