#!/usr/bin/env bash
#
# Usage: $0 <llvm-prefix> <triplet> <gcc-prefix>
#
# Make the clang of an LLVM prefix compile and link for a Linux or MinGW target
# on the GCC toolchain that install-gcc-cross installed into a GCC prefix.
# clang reads the configuration <triplet>.cfg next to it whenever it targets the
# triplet, through --target or through the <triplet>-clang and <triplet>-clang++
# links that this script creates; the configuration names the sysroot of the
# toolchain, its GCC installation (crt files, libgcc, libstdc++), and lld. The
# <triplet>-ar, -nm, -ranlib, -strip, -objcopy, and -readelf links to the LLVM
# tools serve build systems that look for the binary tools of the target by
# their prefixed names, such as the configure script of jemalloc. MinGW targets
# also get <triplet>-windres and -dlltool links to llvm-windres and llvm-dlltool,
# which CMake and libtool call for resource files and import libraries.
#
set -euxo pipefail

llvm="${1:?llvm prefix}"
triplet="${2:?triplet}"
gcc="${3:?gcc prefix}"

gcc_install_dir="$(find "${gcc}/lib/gcc/${triplet}" -mindepth 1 -maxdepth 1 -type d)"
test -f "${gcc_install_dir}/crtbegin.o"

if [[ "${triplet}" == *-w64-mingw32 ]]; then
  # The MinGW driver of clang ignores --gcc-install-dir and looks for GCC in
  # <sysroot>/lib/gcc and for the libstdc++ headers in <sysroot>/include/c++, so
  # both link to the folders of the toolchain. clang reads the configuration of
  # the normalized triplet (x86_64-w64-windows-gnu.cfg) and links with lld: GNU
  # ld of the toolchain links large Rust programs, such as wasm-bindgen, into
  # executables that jump to an unrelocated address at start. Programs link
  # statically and need only system DLLs. libstdc++ of the toolchain uses the
  # posix threads of winpthreads, which the GCC driver links by default and the
  # MinGW driver of clang only with -pthread.
  sysroot="${gcc}/${triplet}/sysroot"
  ln -sfn "../../../lib/gcc" "${sysroot}/lib/gcc"
  ln -sfn "../../include/c++" "${sysroot}/include/c++"
  normalized="$("${llvm}/bin/clang" --target="${triplet}" -print-target-triple)"
  printf -- '%s\n' \
    "--sysroot=${sysroot}" \
    "-fuse-ld=lld" \
    "-static" \
    "-pthread" \
    >"${llvm}/bin/${normalized}.cfg"
else
  printf -- '%s\n' \
    "--sysroot=${gcc}/${triplet}/sysroot" \
    "--gcc-install-dir=${gcc_install_dir}" \
    "-fuse-ld=lld" \
    >"${llvm}/bin/${triplet}.cfg"
fi
ln -sf clang "${llvm}/bin/${triplet}-clang"
ln -sf clang++ "${llvm}/bin/${triplet}-clang++"
tools=(ar nm ranlib strip objcopy readelf)
if [[ "${triplet}" == *-w64-mingw32 ]]; then
  tools+=(windres dlltool)
fi
for tool in "${tools[@]}"; do
  ln -sf "llvm-${tool}" "${llvm}/bin/${triplet}-${tool}"
done

# The MinGW driver appends .exe to the output name.
check_dir="$(mktemp -d)"
printf 'int main(void) { return 0; }\n' | "${llvm}/bin/${triplet}-clang" -x c -o "${check_dir}/check" -
printf '#include <mutex>\nint main() { std::mutex m; m.lock(); m.unlock(); }\n' |
  "${llvm}/bin/${triplet}-clang++" -x c++ -o "${check_dir}/check-cxx" -
if [[ "${triplet}" == *-w64-mingw32 ]]; then
  printf '1 VERSIONINFO\nBEGIN\nEND\n' >"${check_dir}/check.rc"
  "${llvm}/bin/${triplet}-windres" "${check_dir}/check.rc" -O coff -o "${check_dir}/check.res"
fi
rm -rf "${check_dir}"
