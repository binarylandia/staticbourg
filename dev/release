#!/usr/bin/env bash
#
# Usage: $0 [--dry-run] <build time>
#
# Publish the archives of .out/<build time>/ as the GitHub release <build time>
# of binarylandia/staticbourg. Run it on the host that built them, with gh
# signed in, after one build of every task and target with that BUILD_TIME
# (dev/cross/all, and dev/cross/all --target=wasm32-unknown-emscripten).
#
# The release:
#   - is named after the build time, for example 2026-10-21_13-40-13, and has no
#     description
#   - points at the commit that built the archives, which must be clean and on a
#     branch of origin (binarylandia/staticbourg on GitHub). A tag of that name
#     that origin already has must point at the same commit
#   - carries the full set of archives: every task for every native target, and
#     the WebAssembly tasks for wasm32-unknown-emscripten in the plain and mt
#     variants (NATIVE_TARGETS, WASM_TASKS, WASM_VARIANTS in dev/lib/utils.sh),
#     each as .tar.xz, .tar.gz, and .tar.zst
#     (<library>-<version>-static-<target>-<build time>.tar.{xz,gz,zst}),
#     SHA256SUMS, and manifest.json with the build record of every archive
#     (library, version, source and its sha256, target, compiler, the LLVM
#     release and the target toolchain, C flags, build image file and its
#     sha256, build commit; see package_with_record in dev/lib/utils.sh)
#
# A published release is never changed: the script stops when the release
# exists. A fixed archive goes into a new release.
#
# Options:
#   --dry-run    Check and write SHA256SUMS and manifest.json, but publish
#                nothing. A commit that no branch of origin has is reported,
#                not fatal
#   -h, --help   Show this help
#
# Examples:
#   $0 --dry-run 2026-10-21_13-40-13
#   $0 2026-10-21_13-40-13
#
set -euo pipefail
trap "exit" INT

THIS_DIR="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
ROOT_DIR="$(realpath "${THIS_DIR}/..")"
REPO="binarylandia/staticbourg"
# shellcheck source=./lib/utils.sh
source "${THIS_DIR}/lib/utils.sh"

function fail() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

# Fail unless HEAD is a clean commit and origin is the GitHub repository REPO.
# Fail, or with --dry-run only report, when no branch of origin has the commit,
# by the branches of origin fetched now: a stale or deleted remote branch and
# the branches of other remotes do not count.
function check_commit() {
  local commit="${1}"
  local dry_run="${2}"
  if [[ -n "$(git -C "${ROOT_DIR}" status --porcelain)" ]]; then
    fail "the working tree has uncommitted or untracked files"
  fi
  local url
  url="$(git -C "${ROOT_DIR}" remote get-url origin)" || fail "the checkout has no remote origin"
  if ! [[ "${url}" =~ ^(https://github\.com/|git@github\.com:|ssh://git@github\.com/)${REPO}(\.git)?/?$ ]]; then
    fail "origin is ${url}, not ${REPO} on GitHub"
  fi
  local err
  if ! err="$(git -C "${ROOT_DIR}" fetch --quiet --prune origin '+refs/heads/*:refs/remotes/origin/*' 2>&1)"; then
    fail "fetching origin: ${err}"
  fi
  if [[ -z "$(git -C "${ROOT_DIR}" for-each-ref --contains="${commit}" --format='%(refname)' 'refs/remotes/origin/')" ]]; then
    if "${dry_run}"; then
      printf 'WARNING: commit %s is not pushed to origin; publication would stop here\n' "${commit}" >&2
    else
      fail "commit ${commit} is not pushed to origin"
    fi
  fi
}

# Fail unless the build records cover the full set of archives once each: every
# task for each of its native targets (task_targets), and the WebAssembly tasks
# for WASM_TARGET in every variant of WASM_VARIANTS.
function check_matrix() {
  local records=("$@")
  local task target expected actual
  expected="$(
    while IFS= read -r task; do
      while IFS= read -r target; do
        printf '%s %s plain\n' "${task}" "${target}"
      done < <(task_targets "${ROOT_DIR}" "${task}")
    done < <(task_names "${ROOT_DIR}")
    local variant
    for task in "${WASM_TASKS[@]}"; do
      for variant in "${WASM_VARIANTS[@]}"; do
        printf '%s %s %s\n' "${task}" "${WASM_TARGET}" "${variant}"
      done
    done
  )"
  expected="$(LC_ALL=C sort <<<"${expected}")"
  actual="$(jq -r '"\(.task) \(.target) \(.variant)"' "${records[@]}" | LC_ALL=C sort)"

  local missing extra duplicate
  missing="$(LC_ALL=C comm -23 <(printf '%s\n' "${expected}") <(printf '%s\n' "${actual}" | uniq))"
  extra="$(LC_ALL=C comm -13 <(printf '%s\n' "${expected}") <(printf '%s\n' "${actual}" | uniq))"
  duplicate="$(uniq -d <<<"${actual}")"
  [[ -z "${missing}" ]] || fail "no archives of these tasks, targets, and variants:
${missing}"
  [[ -z "${extra}" ]] || fail "archives of tasks, targets, and variants outside the release set:
${extra}"
  [[ -z "${duplicate}" ]] || fail "more than one build record for these tasks, targets, and variants:
${duplicate}"
}

# Fail unless every build record comes from a clean build of the commit at the
# build time and names its archive in the three formats, the files exist, and
# every archive has a build record.
function check_records() {
  local out_dir="${1}"
  local commit="${2}"
  local build_time="${3}"
  shift 3
  local records=("$@")
  local record
  for record in "${records[@]}"; do
    if [[ "$(jq -r '.build_commit' "${record}")" != "${commit}" ]]; then
      fail "${record} comes from commit $(jq -r '.build_commit' "${record}"), not from HEAD ${commit}"
    fi
    if [[ "$(jq -r '.build_dirty' "${record}")" != "false" ]]; then
      fail "${record} comes from a build with uncommitted or untracked files"
    fi
    if [[ "$(jq -r '.build_time' "${record}")" != "${build_time}" ]]; then
      fail "${record} has the build time $(jq -r '.build_time' "${record}"), not ${build_time}"
    fi
    if ! jq -e '. as $r | (.files | sort) == (["tar.gz", "tar.xz", "tar.zst"] | map("\($r.name).\(.)"))' "${record}" >/dev/null; then
      fail "${record} does not name its archive as .tar.xz, .tar.gz, and .tar.zst: $(jq -c '.files' "${record}")"
    fi
    local files=()
    mapfile -t files < <(jq -r '.files[]' "${record}")
    local file
    for file in "${files[@]}"; do
      [[ -f "${out_dir}/${file}" ]] || fail "${record} names ${file}, which is missing"
    done
  done

  local recorded archives
  recorded="$(jq -r '.files[]' "${records[@]}" | LC_ALL=C sort)"
  archives="$(find "${out_dir}" -maxdepth 1 -type f -name '*.tar.*' -printf '%f\n' | LC_ALL=C sort)"
  if [[ "${recorded}" != "${archives}" ]]; then
    fail "the archives in ${out_dir} differ from those of the build records:
$(diff <(printf '%s\n' "${recorded}") <(printf '%s\n' "${archives}") || true)"
  fi
}

# Fail when the GitHub repository REPO has a release with the tag. Only HTTP 404
# for the release, in a repository that exists, counts as absent; every other
# answer or failure of gh stops with its message.
function check_release_absent() {
  local tag="${1}"
  local out
  if ! out="$(gh api "repos/${REPO}" --jq='.full_name' 2>&1)"; then
    fail "gh api repos/${REPO}: ${out}"
  fi

  local endpoint="repos/${REPO}/releases/tags/${tag}"
  local err_file response status=""
  err_file="$(mktemp)"
  response="$(gh api --include "${endpoint}" 2>"${err_file}")" || true # the status line decides
  local err
  err="$(<"${err_file}")"
  rm -f "${err_file}"
  if [[ "${response}" =~ ^HTTP/[0-9.]+\ ([0-9]{3}) ]]; then
    status="${BASH_REMATCH[1]}"
  fi
  case "${status}" in
  404) ;;
  200) fail "release ${tag} exists; a published release is never changed" ;;
  "") fail "gh api ${endpoint}: ${err}" ;;
  *) fail "gh api ${endpoint}: HTTP ${status}: ${err:-${response}}" ;;
  esac
}

# Print the commit of a tag of origin, or nothing when origin has no such tag.
function origin_tag_commit() {
  local tag="${1}"
  local refs
  # An annotated tag lists the tag object, and with the second pattern the
  # commit that it points at as <tag>^{}.
  if ! refs="$(git -C "${ROOT_DIR}" ls-remote --tags origin "refs/tags/${tag}" "refs/tags/${tag}^{}" 2>&1)"; then
    fail "git ls-remote origin refs/tags/${tag}: ${refs}"
  fi
  local sha ref commit=""
  while read -r sha ref; do
    case "${ref}" in
    "refs/tags/${tag}^{}") commit="${sha}" ;;
    "refs/tags/${tag}") commit="${commit:-${sha}}" ;;
    esac
  done <<<"${refs}"
  printf '%s' "${commit}"
}

# Fail when origin has the tag, and it points at a commit other than the build
# commit: gh release create would publish the release at that tag, and not at
# the commit that built the archives.
function check_tag() {
  local tag="${1}"
  local commit="${2}"
  local tag_commit
  tag_commit="$(origin_tag_commit "${tag}")"
  if [[ -n "${tag_commit}" && "${tag_commit}" != "${commit}" ]]; then
    fail "tag ${tag} of origin points at ${tag_commit}, not at the build commit ${commit}"
  fi
}

main() {
  show_help() {
    sed -n '2,${/^#/!q; s/^# \?//p}' "${BASH_SOURCE[0]}" | sed "s|\$0|${0##*/}|g"
  }

  local dry_run=false

  while (($# > 0)); do
    case "${1}" in
    -h | --help)
      show_help
      exit 0
      ;;
    --dry-run)
      dry_run=true
      shift
      ;;
    --)
      shift
      break
      ;;
    -*)
      printf "Unknown option: %s\n" "${1}" >&2
      exit 1
      ;;
    *) break ;;
    esac
  done

  local build_time="${1:-}"
  [[ -n "${build_time}" ]] || {
    show_help >&2
    exit 1
  }
  local out_dir="${ROOT_DIR}/.out/${build_time}"
  [[ -d "${out_dir}" ]] || fail "${out_dir} does not exist"

  local commit
  commit="$(git -C "${ROOT_DIR}" rev-parse HEAD)"
  check_commit "${commit}" "${dry_run}"

  local records=()
  mapfile -t records < <(find "${out_dir}" -maxdepth 1 -type f -name '*.json' ! -name 'manifest.json' | LC_ALL=C sort)
  ((${#records[@]} > 0)) || fail "${out_dir} has no build records"
  check_records "${out_dir}" "${commit}" "${build_time}" "${records[@]}"
  check_matrix "${records[@]}"

  local tag="${build_time}"
  check_release_absent "${tag}"
  check_tag "${tag}" "${commit}"

  local manifest="${out_dir}/manifest.json"
  jq -s --arg repository "${REPO}" --arg commit "${commit}" --arg build_time "${build_time}" \
    '{repository: $repository, commit: $commit, build_time: $build_time, archives: (sort_by(.library, .target, .variant))}' \
    "${records[@]}" >"${manifest}"

  local files=()
  mapfile -t files < <(jq -r '.archives[].files[]' "${manifest}" | LC_ALL=C sort)
  (cd "${out_dir}" && sha256sum -- "${files[@]}" >SHA256SUMS)

  printf 'Release %s at %s: %d archives, %d files\n' "${tag}" "${commit}" "$(jq '.archives | length' "${manifest}")" "${#files[@]}"
  jq -r '.archives[] | "  \(.library) \(.version) \(.target) \(.variant): \(.compiler)"' "${manifest}"
  if "${dry_run}"; then
    printf '\nDry run: nothing published\n'
    return
  fi

  # The tag can appear on origin after the checks above.
  check_tag "${tag}" "${commit}"
  (cd "${out_dir}" && gh release create "${tag}" \
    --repo="${REPO}" \
    --target="${commit}" \
    --title="${tag}" \
    --notes="" \
    -- "${files[@]}" SHA256SUMS manifest.json)

  local tag_commit
  tag_commit="$(origin_tag_commit "${tag}")"
  if [[ "${tag_commit}" != "${commit}" ]]; then
    fail "release ${tag} is published, but its tag points at ${tag_commit:-nothing}, not at ${commit}"
  fi
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
