#!/usr/bin/env bash
#
# Usage: $0
#
# Build static liblzma of xz for CROSS_COMPILE from the checksum-verified release
# tarball, and package it. dev/cross/build sets the environment.
#
# WebAssembly builds have no threads: a module without -pthread cannot link
# objects that use them.
#
# shellcheck disable=SC2155
set -euo pipefail
trap "exit" INT
# shellcheck source=./../../dev/lib/utils.sh
source "${BASH_SOURCE%/*}/../../dev/lib/utils.sh"

NAME="lzma"
VERSION="5.8.4"
SOURCE_URL="https://github.com/tukaani-project/xz/releases/download/v${VERSION}/xz-${VERSION}.tar.gz"

export CROSS_COMPILE="${CROSS_COMPILE:?}"
export BUILD_TIME="${BUILD_TIME:?}"
export BUILD_DIR="${BUILD_DIR:?}"
export INSTALL_DIR="${INSTALL_DIR:?}"
export OUT_DIR="${OUT_DIR:?}"

task_dir="$(abspath "${BASH_SOURCE%/*}")"
build_dir="$(abspath "${BUILD_DIR}")"
install_dir="$(abspath "${INSTALL_DIR}")"
out_dir="$(abspath "${OUT_DIR}")"
src_dir="${build_dir}/${NAME}-${VERSION}"

mkdir -p "${build_dir}"
fetch_verified_tarball "${SOURCE_URL}" "${task_dir}/checksums" "${src_dir}"

pushd "${src_dir}" >/dev/null
{
  host="${CROSS_COMPILE}"
  configure=(./configure)
  threads="yes"
  case "${CROSS_COMPILE}" in
  x86_64-pc-windows-gnu)
    host="x86_64-w64-mingw32"
    ;;
  wasm32-*-emscripten)
    configure=(emconfigure ./configure)
    threads="no"
    ;;
  esac
  if [[ "${CROSS_COMPILE}" != wasm32-* ]]; then
    export CC="ccache ${CC}"
    export CXX="ccache ${CXX}"
  fi

  nicely "${configure[*]}" \
    --prefix="''" \
    --host="${host}" \
    --enable-threads="${threads}" \
    --disable-doc \
    --disable-lzma-links \
    --disable-lzmadec \
    --disable-lzmainfo \
    --disable-nls \
    --disable-scripts \
    --disable-shared \
    --disable-xz \
    --disable-xzdec \
    2>&1 | log "${build_dir}/build.log"

  nicely make -j"${JOBS}" 2>&1 | log "${build_dir}/build.log"
  nicely make -s install DESTDIR="${install_dir}" 2>&1 | log "${build_dir}/build.log"

  sed -i "s|prefix=.*|prefix=\$\{pcfiledir\}/../..|g" "${install_dir}/lib/pkgconfig/liblzma.pc"
  sed -i "s|exec_prefix=.*|exec_prefix=\$\{prefix\}|g" "${install_dir}/lib/pkgconfig/liblzma.pc"
  sed -i "s|libdir=.*|libdir=\$\{exec_prefix\}/lib|g" "${install_dir}/lib/pkgconfig/liblzma.pc"
  sed -i "s|includedir=.*|includedir=\$\{exec_prefix\}/include|g" "${install_dir}/lib/pkgconfig/liblzma.pc"

  install_target_info "${install_dir}"
  package_all "${install_dir}" "${out_dir}/${NAME}-${VERSION}-static-$(package_target_name "${CROSS_COMPILE}")-${BUILD_TIME}"
}
popd >/dev/null
