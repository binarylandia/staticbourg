#!/usr/bin/env bash
#
# Usage: $0
#
# Build static libzstd for CROSS_COMPILE from the checksum-verified release
# tarball, and package it. dev/cross/build sets the environment.
#
# - Legacy format support from v0.1 (ZSTD_LEGACY_LEVEL=1), as the zstd-sys
#   crate builds it
# - Multithreaded compression except in the plain WebAssembly variant: a module
#   without -pthread cannot link objects that use threads
#
# shellcheck disable=SC2155
set -euo pipefail
trap "exit" INT
# shellcheck source=./../../dev/lib/utils.sh
source "${BASH_SOURCE%/*}/../../dev/lib/utils.sh"

NAME="zstd"
VERSION="1.5.7"
SOURCE_URL="https://github.com/facebook/zstd/releases/download/v${VERSION}/zstd-${VERSION}.tar.gz"

export CROSS_COMPILE="${CROSS_COMPILE:?}"
export BUILD_TIME="${BUILD_TIME:?}"
export BUILD_DIR="${BUILD_DIR:?}"
export INSTALL_DIR="${INSTALL_DIR:?}"
export OUT_DIR="${OUT_DIR:?}"

task_dir="$(abspath "${BASH_SOURCE%/*}")"
build_dir="$(abspath "${BUILD_DIR}")"
install_dir="$(abspath "${INSTALL_DIR}")"
out_dir="$(abspath "${OUT_DIR}")"
src_dir="${build_dir}/${NAME}-${VERSION}"

mkdir -p "${build_dir}"
fetch_verified_tarball "${SOURCE_URL}" "${task_dir}/checksums" "${src_dir}"

pushd "${src_dir}" >/dev/null
{
  multithread="ON"
  if [[ "${CROSS_COMPILE}" == wasm32-*-emscripten && "${VARIANT}" != "mt" ]]; then
    multithread="OFF"
  fi

  cmake_configure "build/cmake" "build" \
    -Wno-dev -Wno-deprecated \
    -DCMAKE_INSTALL_PREFIX="${install_dir}" \
    -DCMAKE_INSTALL_LIBDIR="lib" \
    -DCMAKE_INSTALL_INCLUDEDIR="include" \
    -DCMAKE_BUILD_TYPE="Release" \
    -DCMAKE_VERBOSE_MAKEFILE="OFF" \
    -DBUILD_SHARED_LIBS="OFF" \
    -DBUILD_STATIC_LIBS="ON" \
    -DZSTD_BUILD_CONTRIB="OFF" \
    -DZSTD_BUILD_PROGRAMS="OFF" \
    -DZSTD_BUILD_SHARED="OFF" \
    -DZSTD_BUILD_TESTS="OFF" \
    -DZSTD_LEGACY_LEVEL="1" \
    -DZSTD_MULTITHREAD_SUPPORT="${multithread}" \
    2>&1 | log "${build_dir}/build.log"

  nicely cmake --build "build" --parallel="${JOBS}" 2>&1 | log "${build_dir}/build.log"
  nicely cmake --install "build" 2>&1 | log "${build_dir}/build.log"

  sed -i "s|prefix=${install_dir}|prefix=\$\{pcfiledir\}/../..|g" "${install_dir}/lib/pkgconfig/libzstd.pc"

  package_with_record "${install_dir}" "${out_dir}" "${NAME}" "${VERSION}" "${SOURCE_URL}" "$(recorded_sha256 "${SOURCE_URL}" "${task_dir}/checksums")"
}
popd >/dev/null
