#!/usr/bin/env bash
#
# Usage: $0
#
# Build the static OpenMP runtime of LLVM (libomp) for CROSS_COMPILE from the
# checksum-verified llvm-project release tarball, and package it. clang compiles
# `-fopenmp` code into calls of this runtime; link it with -lomp, for example
# through the openmp.pc of the archive. dev/cross/build sets the environment.
#
# - The version is the LLVM of the build images, so the runtime matches the
#   clang that compiles the programs
# - No libgomp or libiomp5 aliases, which would hide libgomp of GCC
# - tasks/openmp/targets lists the targets: LLVM builds no static libomp for
#   Windows
#
# shellcheck disable=SC2155
set -euo pipefail
trap "exit" INT
# shellcheck source=./../../dev/lib/utils.sh
source "${BASH_SOURCE%/*}/../../dev/lib/utils.sh"

NAME="openmp"
VERSION="23.1.4"
SOURCE_URL="https://github.com/llvm/llvm-project/releases/download/llvmorg-${VERSION}/llvm-project-${VERSION}.src.tar.xz"

export CROSS_COMPILE="${CROSS_COMPILE:?}"
export BUILD_TIME="${BUILD_TIME:?}"
export BUILD_DIR="${BUILD_DIR:?}"
export INSTALL_DIR="${INSTALL_DIR:?}"
export OUT_DIR="${OUT_DIR:?}"

task_dir="$(abspath "${BASH_SOURCE%/*}")"
build_dir="$(abspath "${BUILD_DIR}")"
install_dir="$(abspath "${INSTALL_DIR}")"
out_dir="$(abspath "${OUT_DIR}")"
src_dir="${build_dir}/${NAME}-${VERSION}"

mkdir -p "${build_dir}"
# The runtimes build reads these parts of the LLVM source.
fetch_verified_tarball "${SOURCE_URL}" "${task_dir}/checksums" "${src_dir}" \
  cmake runtimes llvm/cmake llvm/utils/llvm-lit third-party openmp

pushd "${src_dir}" >/dev/null
{
  cmake_configure "runtimes" "build" \
    -Wno-dev -Wno-deprecated \
    -DCMAKE_INSTALL_PREFIX="${install_dir}" \
    -DCMAKE_INSTALL_LIBDIR="lib" \
    -DCMAKE_INSTALL_INCLUDEDIR="include" \
    -DCMAKE_BUILD_TYPE="Release" \
    -DLLVM_ENABLE_RUNTIMES="openmp" \
    -DLLVM_ENABLE_PER_TARGET_RUNTIME_DIR="OFF" \
    -DLLVM_INCLUDE_DOCS="OFF" \
    -DLLVM_INCLUDE_TESTS="OFF" \
    -DLIBOMP_ENABLE_SHARED="OFF" \
    -DLIBOMP_INSTALL_ALIASES="OFF" \
    -DLIBOMP_OMPD_SUPPORT="OFF" \
    -DOPENMP_ENABLE_LIBOMPTARGET="OFF" \
    -DOPENMP_ENABLE_OMPT_TOOLS="OFF" \
    2>&1 | log "${build_dir}/build.log"

  nicely cmake --build "build" --parallel="${JOBS}" 2>&1 | log "${build_dir}/build.log"
  nicely cmake --install "build" 2>&1 | log "${build_dir}/build.log"

  test -f "${install_dir}/lib/libomp.a"
  test -f "${install_dir}/include/omp.h"

  # libomp calls pthreads and, on Linux, dlsym.
  libs_private="-lpthread"
  if [[ "${CROSS_COMPILE}" == *-linux-* ]]; then
    libs_private="-lpthread -ldl"
  fi
  mkdir -p "${install_dir}/lib/pkgconfig"
  cat <<PC >"${install_dir}/lib/pkgconfig/openmp.pc"
prefix=\${pcfiledir}/../..
libdir=\${prefix}/lib
includedir=\${prefix}/include

Name: openmp
Description: The OpenMP runtime of LLVM (libomp)
Version: ${VERSION}
Libs: -L\${libdir} -lomp
Libs.private: ${libs_private}
Cflags: -I\${includedir}
PC
  install -D -m 0644 "${src_dir}/openmp/LICENSE.TXT" "${install_dir}/share/doc/openmp/LICENSE.TXT"

  package_with_record "${install_dir}" "${out_dir}" "${NAME}" "${VERSION}" "${SOURCE_URL}" "$(recorded_sha256 "${SOURCE_URL}" "${task_dir}/checksums")"
}
popd >/dev/null
